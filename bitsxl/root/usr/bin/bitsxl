def cmd_json_dashboard():
    a, act, acc = load_active_account()
    if not acc:
        return
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if refresh_account(acc, t):
        out_json({"ok": False, "error": "refresh failed", "number": acc["number"]})
        return
    account_sync(a, acc, t)
    bal = get_balance_retry(a, acc, t)
    quota = get_quota_retry(a, acc, t)
    if api_auth_failed(bal) or api_auth_failed(quota):
        out_json({"ok": False, "error": "auth failed", "number": acc["number"], "balance": jval(bal), "quota": jval(quota)})
        return
    out_json({"ok": True, "number": acc["number"], "subscription_type": acc["subscription_type"],
              "balance": jval(bal), "quota": jval(quota)})


def cmd_json_accounts():
    a = accounts_load()
    act = active_get()
    out = {"ok": True}
    out.update(json_accounts_fields(a, act))
    out_json(out)


def cmd_json_env():
    prepaid_valid = decoy_package_number_parse(CFG["DECOY_PREPAID_PACKAGE_NUMBER"]) is not None
    prior_valid = decoy_package_number_parse(CFG["DECOY_PRIORITAS_PACKAGE_NUMBER"]) is not None
    hybrid_valid = decoy_package_number_parse(CFG["DECOY_PRIOHYBRID_PACKAGE_NUMBER"]) is not None
    env = {
        "BASE_API_URL": bool(CFG["BASE_API_URL"]), "BASE_CIAM_URL": bool(CFG["BASE_CIAM_URL"]),
        "BASIC_AUTH": bool(CFG["BASIC_AUTH"]), "AX_FP_KEY": bool(CFG["AX_FP_KEY"]),
        "UA": bool(CFG["UA"]), "API_KEY": bool(CFG["API_KEY"]),
        "ENCRYPTED_FIELD_KEY": bool(CFG["ENCRYPTED_FIELD_KEY"]), "XDATA_KEY": bool(CFG["XDATA_KEY"]),
        "AX_API_SIG_KEY": bool(CFG["AX_API_SIG_KEY"]), "X_API_BASE_SECRET": bool(CFG["X_API_BASE_SECRET"]),
        "DECOY_PREPAID_FAMILY_CODE": bool(CFG["DECOY_PREPAID_FAMILY_CODE"]),
        "DECOY_PREPAID_PACKAGE_NUMBER": prepaid_valid,
        "DECOY_PRIORITAS_FAMILY_CODE": bool(CFG["DECOY_PRIORITAS_FAMILY_CODE"]),
        "DECOY_PRIORITAS_PACKAGE_NUMBER": prior_valid,
        "DECOY_PRIOHYBRID_FAMILY_CODE": bool(CFG["DECOY_PRIOHYBRID_FAMILY_CODE"]),
        "DECOY_PRIOHYBRID_PACKAGE_NUMBER": hybrid_valid,
    }
    out_json({"ok": True, "home": CFG["home"], "env_path": CFG["env_path"], "env": env, "libmbedcrypto": True})


def cmd_json_quota(number_arg, fresh):
    a = accounts_load()
    act = None
    number = number_arg
    if not number:
        act = active_get()
        number = act
    acc = accounts_find(a, number) if number else None
    if not acc:
        out_json({"ok": False, "error": "account not found", "active": number or ""})
        return
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if refresh_account(acc, t):
        out_json({"ok": False, "error": "refresh failed", "number": acc["number"]})
        return
    account_sync(a, acc, t)
    if fresh:
        response_cache_delete(acc, "quota")
    quota = get_quota_retry(a, acc, t)
    if api_auth_failed(quota):
        json_auth_error(quota)
    else:
        print(quota)


