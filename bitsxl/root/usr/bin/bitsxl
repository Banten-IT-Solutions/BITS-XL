def cmd_json_package_detail(option_code, family_code, variant_code, enterprise_arg):
    if not option_code:
        out_json({"ok": False, "error": "missing package code"})
        return
    a, act, acc = load_active_account()
    if not acc:
        return
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if refresh_account(acc, t):
        out_json({"ok": False, "error": "refresh failed", "number": acc["number"]})
        return
    account_sync(a, acc, t)
    detail = get_package_detail_retry_ex(a, acc, t, option_code, family_code or "", variant_code or "", is_true(enterprise_arg))
    if api_auth_failed(detail):
        json_auth_error(detail)
        return
    o = parse_json(detail)
    ok = isinstance(o, dict) and o.get("status") == "SUCCESS" and isinstance(o.get("data"), dict) and isinstance(o["data"].get("package_option"), dict)
    if not ok:
        out_json({"ok": False, "error": "package detail failed", "action_param": option_code, "response": jval(detail)})
        return
    out_json({"ok": True, "action_param": option_code, "detail": jval(detail)})


def get_package_detail_retry_ex(a, acc, t, code, family, variant, ent):
    r = get_package_detail_api_ex(t, code, family, variant, ent, "NONE")
    if api_auth_failed(r) and not api_retry_auth(acc, a, t):
        r = get_package_detail_api_ex(t, code, family, variant, ent, "NONE")
    return r


def cmd_json_payment_quote(option_code):
    if not option_code:
        out_json({"ok": False, "error": "missing package code"})
        return
    a, act, acc, t = json_payment_begin()
    if not acc:
        return
    q = empty_quote()
    if payment_quote_load(t, option_code, q):
        out_json({"ok": False, "error": "quote failed"})
        return
    out_json({"ok": True, "action_param": option_code, "quote": payment_quote_print_json(q)})


def cmd_json_payment_probe(option_code):
    if not option_code:
        out_json({"ok": False, "error": "missing package code"})
        return
    a, act, acc, t = json_payment_begin()
    if not acc:
        return
    q = empty_quote()
    if payment_quote_load(t, option_code, q):
        out_json({"ok": False, "error": "quote failed"})
        return
    methods = payment_methods_api(t, q)
    if api_auth_failed(methods) and not api_retry_auth(acc, a, t):
        methods = payment_methods_api(t, q)
    if api_auth_failed(methods):
        json_auth_error(methods)
        return
    ok = api_success_response(methods)
    out = {"ok": ok, "action_param": option_code, "quote": payment_quote_print_json(q), "payment_methods": jval(methods)}
    if not ok:
        out["error"] = "payment methods failed"
    out_json(out)


def payment_config_missing():
    m = config_missing()
    if m:
        return m
    if not CFG["ENCRYPTED_FIELD_KEY"]:
        return "ENCRYPTED_FIELD_KEY"
    return None


def cmd_json_payment_pulsa(option_code, confirm_arg, custom_amount):
    m = payment_config_missing()
    if m:
        out_json({"ok": False, "error": "missing env", "missing": m})
        return
    if not option_code:
        out_json({"ok": False, "error": "missing package code"})
        return
    a, act, acc, t = json_payment_begin()
    if not acc:
        return
    q = empty_quote()
    if payment_quote_load(t, option_code, q):
        out_json({"ok": False, "error": "quote failed"})
        return
    amount = payment_amount(q["price"], custom_amount)
    expect = f"BAYAR-{amount}"
    if not confirm_arg or confirm_arg != expect:
        out_json({"ok": False, "error": "confirm required", "confirm": expect,
                  "quote": payment_quote_print_json(q), "total_amount": amount})
        return
    resp = payment_pulsa_settle_many(a, t, [q], 1, amount)
    o = parse_json(resp)
    status = jget_s(o, "status")
    msg = jget_s(o, "message")
    ok = payment_ok_status(status)
    out_json({"ok": ok, "payment": "pulsa", "message": msg or status or "unknown",
              "quote": payment_quote_print_json(q), "total_amount": amount, "response": jval(resp)})


def cmd_json_payment_pulsa_cart(n, codes, custom_amount):
    m = payment_config_missing()
    if m:
        out_json({"ok": False, "error": "missing env", "missing": m})
        return
    if require_json_payment_confirmed():
        return
    if n < 1:
        out_json({"ok": False, "error": "missing package code"})
        return
    if n > 3:
        out_json({"ok": False, "error": "cart max 3 packages"})
        return
    a, act, acc, t = json_payment_begin()
    if not acc:
        return
    total = [0]
    loaded = [0]
    q = []
    if load_payment_quotes_json(a, acc, t, n, codes, q, 3, total, loaded):
        return
    amount = payment_amount(total[0], custom_amount)
    resp = payment_pulsa_settle_many(a, t, q, loaded[0], amount)
    o = parse_json(resp)
    status = jget_s(o, "status")
    msg = jget_s(o, "message")
    ok = payment_ok_status(status)
    out_json({"ok": ok, "payment": "pulsa", "message": msg or status or "unknown",
              "quotes": print_quotes_json(q), "total_amount": amount, "response": jval(resp)})


