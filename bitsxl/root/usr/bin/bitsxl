def die(msg, code=1):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


# ---------------------------------------------------------------------------
# crypto (byte-exact)
# ---------------------------------------------------------------------------
def sha256(m):
    return hashlib.sha256(m).digest()


def sha512(m):
    return hashlib.sha512(m).digest()


def md5(m):
    return hashlib.md5(m).digest()


def hmac_hash(sha512_mode, key, msg):
    return hmac.new(key, msg, hashlib.sha512 if sha512_mode else hashlib.sha256).digest()


def b64_encode(data, urlsafe=False):
    if urlsafe:
        return base64.urlsafe_b64encode(data).decode()
    return base64.b64encode(data).decode()


def b64_decode(s):
    # lenient: accept both standard (`+/`) and urlsafe (`-_`) alphabets (C b64_val maps both).
    try:
        return base64.b64decode(s, altchars=b"-_", validate=False)
    except Exception:
        return b""


def hex_encode(b):
    return b.hex()


def pkcs7_pad(data):
    pad = 16 - (len(data) % 16)
    return data + bytes([pad]) * pad


def pkcs7_unpad(buf):
    if not buf:
        return None
    pad = buf[-1]
    if pad < 1 or pad > 16 or pad > len(buf):
        return None
    if buf[-pad:] != bytes([pad]) * pad:
        return None
    return buf[:-pad]


def aes_cbc(enc, key, iv, data):
    if AES is None:
        die("aes pycryptodome missing")
    key = key.encode() if isinstance(key, str) else key
    iv = iv.encode() if isinstance(iv, str) else iv
    data = data.encode() if isinstance(data, str) else data
    c = AES.new(key, AES.MODE_CBC, iv)
    return c.encrypt(data) if enc else c.decrypt(data)


def encrypt_xdata(plain, xtime):
    xt = str(xtime)
    digest = sha256(xt.encode())
    hx = digest.hex()
    iv = hx.encode()[:16]
    padded = pkcs7_pad(plain.encode() if isinstance(plain, str) else plain)
    ct = aes_cbc(True, CFG["XDATA_KEY"], iv, padded)
    return b64_encode(ct, urlsafe=True)


def decrypt_xdata_payload(j):
    o = parse_json(j)
    if not isinstance(o, dict):
        return None
    xdata = o.get("xdata")
    xtime = o.get("xtime")
    if not isinstance(xdata, str) or not isinstance(xtime, int):
        return None
    xt = str(xtime)
    digest = sha256(xt.encode())
    hx = digest.hex()
    iv = hx.encode()[:16]
    ct = b64_decode(xdata)
    if len(ct) % 16:
        return None
    pt = aes_cbc(False, CFG["XDATA_KEY"], iv, ct)
    pt = pkcs7_unpad(pt)
    if pt is None:
        return None
    return pt.decode("utf-8", "replace")


def make_x_signature(id_token, method, path, sig_time):
    key = f"{CFG['X_API_BASE_SECRET']};{id_token};{method};{path};{sig_time}"
    msg = f"{id_token};{sig_time};"
    return hmac_hash(True, key.encode(), msg.encode()).hex()


def make_x_signature_payment(access_token, payment_ts, package_code, token_payment, payment_method, payment_for, path):
    key = f"{CFG['X_API_BASE_SECRET']};{payment_ts}#ae-hei_9Tee6he+Ik3Gais5=;POST;{path};{payment_ts}"
    msg = f"{access_token};{token_payment};{payment_ts};{payment_for};{payment_method};{package_code};"
    return hmac_hash(True, key.encode(), msg.encode()).hex()


def make_x_signature_bounty(access_token, sig_time, package_code, token):
    path = "api/v8/personalization/bounties-exchange"
    key = f"{CFG['X_API_BASE_SECRET']};{access_token};{sig_time}#ae-hei_9Tee6he+Ik3Gais5=;POST;{path};{sig_time}"
    msg = f"{access_token};{token};{sig_time};{package_code};"
    return hmac_hash(True, key.encode(), msg.encode()).hex()


def make_x_signature_loyalty(sig_time, package_code, token, path):
    key = f"{CFG['X_API_BASE_SECRET']};{sig_time}#ae-hei_9Tee6he+Ik3Gais5=;POST;{path};{sig_time}"
    msg = f"{token};{sig_time};{package_code};"
    return hmac_hash(True, key.encode(), msg.encode()).hex()


def make_x_signature_bounty_allotment(sig_time, package_code, token, path, dest):
    key = f"{CFG['X_API_BASE_SECRET']};{sig_time}#ae-hei_9Tee6he+Ik3Gais5=;{dest};POST;{path};{sig_time}"
    msg = f"{token};{sig_time};{dest};{package_code};"
    return hmac_hash(True, key.encode(), msg.encode()).hex()


def encrypted_empty_field():
    if not CFG["ENCRYPTED_FIELD_KEY"]:
        return ""
    rb = os.urandom(8)
    iv_hex = rb.hex()
    iv = iv_hex.encode()
    pt = bytes([16]) * 16
    ct = aes_cbc(True, CFG["ENCRYPTED_FIELD_KEY"], iv, pt)
    return b64_encode(ct, urlsafe=True) + iv_hex


def make_ax_api_signature(ts, contact, code, contact_type):
    pre = f"{ts}password{contact_type}{contact}{code}openid"
    mac = hmac_hash(False, CFG["AX_API_SIG_KEY"].encode(), pre.encode())
    return b64_encode(mac, urlsafe=False)


def ax_fingerprint():
    path = os.path.join(CFG["home"], "ax.fp")
    try:
        with open(path, "r") as f:
            existing = f.read().strip()
        if existing:
            return existing
    except Exception:
        pass
    r1 = 1000 + (int.from_bytes(os.urandom(2), "big") % 9000)
    r2 = 1000 + (int.from_bytes(os.urandom(2), "big") % 9000)
    plain = f"samsung{r1}|SM-N93{r2}|en|720x1540|GMT07:00|192.169.69.69|1.0|Android 13|6281398370564"
    iv = b"\x00" * 16
    padded = pkcs7_pad(plain.encode())
    ct = aes_cbc(True, CFG["AX_FP_KEY"], iv, padded)
    b64 = b64_encode(ct, urlsafe=False)
    try:
        os.makedirs(CFG["home"], mode=0o700, exist_ok=True)
        with open(path, "w") as f:
            f.write(b64)
    except Exception:
        pass
    return b64


def ax_device_id(fp):
    return md5(fp.encode()).hex()


def now_ms():
    return int(time.time() * 1000)


def uuid_v4():
    b = bytearray(os.urandom(16))
    b[6] = (b[6] & 0x0F) | 0x40
    b[8] = (b[8] & 0x3F) | 0x80
    h = b.hex()
    return f"{h[0:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:32]}"


def timestamp_java_local():
    ms = now_ms()
    t = time.localtime(ms // 1000)
    zraw = time.strftime("%z", t) or "+0000"
    z = zraw[:3] + ":" + zraw[3:] if len(zraw) == 5 else zraw
    base = time.strftime("%Y-%m-%dT%H:%M:%S", t)
    return f"{base}.{(ms % 1000) // 10:02d}{z}"


def timestamp_gmt7(minus_seconds):
    ms = now_ms() - minus_seconds * 1000
    t = time.gmtime(ms // 1000 + 7 * 3600)
    base = time.strftime("%Y-%m-%dT%H:%M:%S", t)
    return f"{base}.{ms % 1000:03d}+0700"


def timestamp_gmt7_colon():
    ms = now_ms()
    t = time.gmtime(ms // 1000 + 7 * 3600)
    base = time.strftime("%Y-%m-%dT%H:%M:%S", t)
    return f"{base}.{(ms % 1000) // 10:02d}+07:00"


# ---------------------------------------------------------------------------
# json / string helpers
# ---------------------------------------------------------------------------
def parse_json(s):
    if s is None:
        return None
    if isinstance(s, (dict, list)):
        return s
    try:
        return json.loads(s)
    except Exception:
        return None


def jstr(s):
    return json.dumps("" if s is None else s, ensure_ascii=False)


def jval(s):
    """Embed an API response: parsed object if valid JSON, else the raw string."""
    o = parse_json(s)
    if o is not None:
        return o
    return "" if s is None else s


def jget_s(obj, key):
    if isinstance(obj, dict):
        v = obj.get(key)
        return v if isinstance(v, str) else None
    return None


def jget_ll(obj, key, defv=-1):
    if isinstance(obj, dict):
        v = obj.get(key)
        if isinstance(v, int) and not isinstance(v, bool):
            return v
        if isinstance(v, str):
            try:
                return int(v)
            except ValueError:
                return defv
    return defv


def jget_llany(obj, key, defv=-1):
    return jget_ll(obj, key, defv)


def jdup(obj, key):
    if isinstance(obj, dict):
        v = obj.get(key)
        return v if isinstance(v, (dict, list)) else None
    return None


def trim(s):
    return s.strip()


def url_encode(s):
    from urllib.parse import quote
    return quote(s, safe="~-_.!*'()")


def is_true(s):
    return s in ("1", "y", "Y", "true", "TRUE", "yes", "YES")


def money_id(v):
    s = str(v)
    n = len(s)
    out = []
    for i, ch in enumerate(reversed(s)):
        if i and i % 3 == 0:
            out.append(".")
        out.append(ch)
    return "".join(reversed(out))


# ---------------------------------------------------------------------------
# config
# ---------------------------------------------------------------------------
def load_env_file(path):
    try:
        with open(path, "r") as f:
            lines = f.read().splitlines()
    except Exception:
        return -1
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in ('"', "'"):
            v = v[1:-1]
        if k in CFG:
            CFG[k] = v
    return 0


CONFIG_REQUIRED = ["BASE_API_URL", "BASE_CIAM_URL", "BASIC_AUTH", "AX_FP_KEY", "UA", "API_KEY", "XDATA_KEY", "AX_API_SIG_KEY", "X_API_BASE_SECRET"]


def config_missing():
    for k in CONFIG_REQUIRED:
        if not CFG.get(k):
            return k
    return None


def ensure_dir(path):
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
    except Exception:
        pass


def load_uci_config():
    # UCI is the source of truth on OpenWrt (LuCI Settings wins over env file).
    import subprocess
    try:
        out = subprocess.run(["uci", "show", "bitsxl"], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return
    for line in out.splitlines():
        i = line.find(".config.")
        if i < 0:
            continue
        rest = line[i + len(".config."):]
        if "=" not in rest:
            continue
        k, v = rest.split("=", 1)
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] == "'":
            v = v[1:-1]
        if k in CFG:
            CFG[k] = v


def load_config():
    home = os.environ.get("BITSXL_HOME")
    if not home:
        uh = os.environ.get("HOME")
        home = f"{uh}/.bitsxl" if uh else "/root/.bitsxl"
    CFG["home"] = home
    env = os.environ.get("BITSXL_ENV")
    loaded = False
    if env:
        if load_env_file(env) == 0:
            CFG["env_path"] = env
            loaded = True
    if not loaded:
        for p in ("/etc/bitsxl/.env", "/etc/bitsxl.env", ".env"):
            if load_env_file(p) == 0:
                CFG["env_path"] = p
                loaded = True
                break
    load_uci_config()
    ensure_dir(CFG["home"])


def require_config():
    m = config_missing()
    if m:
        die(f"missing env {m} in /etc/bitsxl/.env or /etc/bitsxl.env")


# ---------------------------------------------------------------------------
# http
# ---------------------------------------------------------------------------
def http_fetch(url, method, headers, body=None):
    import urllib.request
    import urllib.error
    import ssl

    if not url:
        return '{"status":"FAILED","code":"HTTP_FETCH_FAILED","exit":3,"curl":3}'
    hdrs = {}
    for h in headers or []:
        h = h[9:] if h.startswith("--header=") else h
        if ":" in h:
            k, val = h.split(":", 1)
            hdrs[k.strip()] = val.strip()
    data = body.encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method="POST" if body is not None else "GET")
    for k, val in hdrs.items():
        req.add_header(k, val)
    ctx = ssl.create_default_context()
    resp_body = b""
    try:
        with urllib.request.urlopen(req, timeout=30, context=ctx) as r:
            while True:
                chunk = r.read(65536)
                if not chunk:
                    break
                resp_body += chunk
                if len(resp_body) > HTTP_RESPONSE_MAX:
                    return f'{{"status":"FAILED","code":"HTTP_RESPONSE_TOO_LARGE","limit":{HTTP_RESPONSE_MAX}}}'
    except urllib.error.HTTPError as e:
        resp_body = e.read() if e.fp else b""
    except urllib.error.URLError as e:
        # keep the body we may have; return failure JSON
        pass
    except Exception as e:
        return '{"status":"FAILED","code":"HTTP_FETCH_FAILED","exit":1,"curl":1}'
    if not resp_body:
        # could be a successful empty response
        return resp_body.decode("utf-8", "replace")
    return resp_body.decode("utf-8", "replace")


def http_fetch_failed(code):
    return f'{{"status":"FAILED","code":"HTTP_FETCH_FAILED","exit":{code},"curl":{code}}}'


def host_from_url(url):
    p = url.find("://")
    h = url[p + 3:] if p >= 0 else url
    slash = h.find("/")
    return h[:slash] if slash >= 0 else h


# ---------------------------------------------------------------------------
# api requests
# ---------------------------------------------------------------------------
def ciam_headers(content_type, bearer_token, ax_sig, ax_req_at):
    fp = ax_fingerprint()
    dev = ax_device_id(fp)
    host = host_from_url(CFG["BASE_CIAM_URL"])
    u = uuid_v4()
    at = ax_req_at if ax_req_at else timestamp_gmt7_colon()
    auth = f"Bearer {bearer_token}" if bearer_token else f"Basic {CFG['BASIC_AUTH']}"
    h = ["Accept-Encoding: identity", f"Authorization: {auth}"]
    if ax_sig:
        h.append(f"Ax-Api-Signature: {ax_sig}")
    h += [
        f"Ax-Device-Id: {dev}",
        f"Ax-Fingerprint: {fp}",
        f"Ax-Request-At: {at}",
        "Ax-Request-Device: samsung",
        "Ax-Request-Device-Model: SM-N935F",
        f"Ax-Request-Id: {u}",
        "Ax-Substype: PREPAID",
        f"Content-Type: {content_type}",
        f"Host: {host}",
        f"User-Agent: {CFG['UA']}",
    ]
    return h


def api_request(path, payload, id_token):
    if not id_token:
        return '{"status":"FAILED","code":"REQUEST_MISSING_BEARER","message":"missing id_token"}'
    xtime = now_ms()
    sig_time = xtime // 1000
    xdata = encrypt_xdata(payload, xtime)
    body = json.dumps({"xdata": xdata, "xtime": xtime})
    sig = make_x_signature(id_token, "POST", path, sig_time)
    host = host_from_url(CFG["BASE_API_URL"])
    url = f"{CFG['BASE_API_URL']}/{path}"
    h = [
        f"host: {host}",
        "content-type: application/json; charset=utf-8",
        f"user-agent: {CFG['UA']}",
        f"x-api-key: {CFG['API_KEY']}",
        f"Authorization: Bearer {id_token}",
        "x-hv: v3",
        f"x-signature-time: {sig_time}",
        f"x-signature: {sig}",
        f"x-request-id: {uuid_v4()}",
        f"x-request-at: {timestamp_java_local()}",
        "x-version-app: 8.9.0",
    ]
    resp = http_fetch(url, "POST", h, body)
    plain = decrypt_xdata_payload(resp)
    return plain if plain is not None else resp


def api_request_payment(path, payload, t, payment_targets, token_payment, payment_for, payment_ts):
    if not t.get("id_token") or not t.get("access_token"):
        return '{"status":"FAILED","code":"REQUEST_MISSING_BEARER","message":"missing token"}'
    return _api_request_payment_impl(path, payload, t, payment_targets, token_payment, "BALANCE", payment_for, payment_ts)


def api_request_payment_method(path, payload, t, payment_targets, token_payment, payment_method, payment_for, payment_ts):
    if not t.get("id_token") or not t.get("access_token"):
        return '{"status":"FAILED","code":"REQUEST_MISSING_BEARER","message":"missing token"}'
    return _api_request_payment_impl(path, payload, t, payment_targets, token_payment, payment_method, payment_for, payment_ts)


def _api_request_payment_impl(path, payload, t, payment_targets, token_payment, payment_method, payment_for, payment_ts):
    xtime = now_ms()
    sig_time = xtime // 1000
    xdata = encrypt_xdata(payload, xtime)
    body = json.dumps({"xdata": xdata, "xtime": xtime})
    sig = make_x_signature_payment(t["access_token"], payment_ts, payment_targets, token_payment, payment_method, payment_for, path)
    host = host_from_url(CFG["BASE_API_URL"])
    url = f"{CFG['BASE_API_URL']}/{path}"
    h = [
        f"host: {host}",
        "content-type: application/json; charset=utf-8",
        f"user-agent: {CFG['UA']}",
        f"x-api-key: {CFG['API_KEY']}",
        f"Authorization: Bearer {t['id_token']}",
        "x-hv: v3",
        f"x-signature-time: {sig_time}",
        f"x-signature: {sig}",
        f"x-request-id: {uuid_v4()}",
        f"x-request-at: {timestamp_java_local()}",
        "x-version-app: 8.9.0",
    ]
    resp = http_fetch(url, "POST", h, body)
    plain = decrypt_xdata_payload(resp)
    return plain if plain is not None else resp


def api_request_custom_sig(path, payload, t, sig):
    if not t.get("id_token"):
        return '{"status":"FAILED","code":"REQUEST_MISSING_BEARER","message":"missing id_token"}'
    xtime = now_ms()
    sig_time = xtime // 1000
    xdata = encrypt_xdata(payload, xtime)
    body = json.dumps({"xdata": xdata, "xtime": xtime})
    host = host_from_url(CFG["BASE_API_URL"])
    url = f"{CFG['BASE_API_URL']}/{path}"
    h = [
        f"host: {host}",
        "content-type: application/json; charset=utf-8",
        f"user-agent: {CFG['UA']}",
        f"x-api-key: {CFG['API_KEY']}",
        f"Authorization: Bearer {t['id_token']}",
        "x-hv: v3",
        f"x-signature-time: {sig_time}",
        f"x-signature: {sig}",
        f"x-request-id: {uuid_v4()}",
        f"x-request-at: {timestamp_java_local()}",
        "x-version-app: 8.9.0",
    ]
    resp = http_fetch(url, "POST", h, body)
    plain = decrypt_xdata_payload(resp)
    return plain if plain is not None else resp


def request_otp(number):
    num = url_encode(number)
    url = f"{CFG['BASE_CIAM_URL']}/realms/xl-ciam/auth/otp?contact={num}&contactType=SMS&alternateContact=false"
    h = ciam_headers("application/json", None, None, None)
    return http_fetch(url, "GET", h)


def submit_otp(contact_type, contact, code):
    ts_sign = timestamp_gmt7(0)
    ts_head = timestamp_gmt7(300)
    final_contact = b64_encode(contact.encode(), urlsafe=False) if contact_type == "DEVICEID" else contact
    sig = make_ax_api_signature(ts_sign, final_contact, code, contact_type)
    body = f"contactType={url_encode(contact_type)}&code={url_encode(code)}&grant_type=password&contact={url_encode(final_contact)}&scope=openid"
    url = f"{CFG['BASE_CIAM_URL']}/realms/xl-ciam/protocol/openid-connect/token"
    h = ciam_headers("application/x-www-form-urlencoded", None, sig, ts_head)
    return http_fetch(url, "POST", h, body)


def extend_session(subscriber_id):
    b = b64_encode(subscriber_id.encode(), urlsafe=False)
    url = f"{CFG['BASE_CIAM_URL']}/realms/xl-ciam/auth/extend-session?contact={url_encode(b)}&contactType=DEVICEID"
    h = ciam_headers("application/json", None, None, None)
    return http_fetch(url, "GET", h)


def refresh_token_http(refresh_token):
    body = f"grant_type=refresh_token&refresh_token={url_encode(refresh_token)}"
    url = f"{CFG['BASE_CIAM_URL']}/realms/xl-ciam/protocol/openid-connect/token"
    h = ciam_headers("application/x-www-form-urlencoded", None, None, None)
    return http_fetch(url, "POST", h, body)


