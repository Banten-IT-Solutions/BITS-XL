    if not acc:
        return
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if refresh_account(acc, t):
        out_json({"ok": False, "error": "refresh failed", "number": acc["number"]})
        return
    account_sync(a, acc, t)
    pending = get_pending_transactions_retry(a, acc, t)
    o = parse_json(pending)
    ok = not api_auth_failed(pending) and api_success_response(pending)
    has_pending = False
    if isinstance(o, dict):
        pp = o.get("pending_payment")
        has_pending = isinstance(pp, list) and len(pp) > 0
    out = {"ok": ok, "has_pending_payment": has_pending, "number": acc["number"],
           "subscription_type": acc["subscription_type"], "pending": jval(pending)}
    if not ok:
        out["error"] = "pending transactions failed"
    out_json(out)


