def get_store_family_packages_context_result(t, family_code, enterprise_arg, migration_arg, resolved_context=None, result_out=None):
    migrations = ["NONE", "PRE_TO_PRIOH", "PRIOH_TO_PRIO", "PRIO_TO_PRIOH"]
    if migration_arg:
        migrations = [migration_arg]
    ent_values = [False, True]
    if enterprise_arg is not None:
        ent_values = [is_true(enterprise_arg)]
    if result_out is not None:
        result_out[0] = -1  # DECOY_RESOLVE_FAILED
    error_151 = None
    error_151_context = None
    last = None
    for mi in migrations:
        for ent in ent_values:
            payload = json.dumps({
                "is_show_tagging_tab": True, "is_dedicated_event": True, "is_transaction_routine": False,
                "migration_type": mi, "package_family_code": family_code, "is_autobuy": False,
                "is_enterprise": ent, "is_pdlp": True, "referral_code": "", "is_migration": False, "lang": "en",
            })
            resp = api_request("api/v8/xl-stores/options/list", payload, t["id_token"])
            o = parse_json(resp)
            status = jget_s(o, "status")
            data = jdup(o, "data") if isinstance(o, dict) else None
            family = jdup(data, "package_family") if isinstance(data, dict) else None
            name = jget_s(family, "name") if isinstance(family, dict) else None
            if status == "SUCCESS" and name:
                # resolved context
                if resolved_context is not None:
                    resolved_context.update(resolved_context_set("", family_code, "", ent, mi, 0, 0))
                if result_out is not None:
                    result_out[0] = 0
                return resp
            if api_auth_failed(resp):
                if result_out is not None:
                    result_out[0] = -3  # DECOY_RESOLVE_RETRY_AUTH
                return resp
            if error_151 is None and api_error_151(resp):
                error_151 = resp
                error_151_context = resolved_context_set("", family_code, "", ent, mi, 0, 0)
            last = resp
    if error_151:
        if resolved_context is not None:
            resolved_context.update(error_151_context)
        if result_out is not None:
            result_out[0] = -2  # DECOY_RESOLVE_RETRY_151
        return error_151
    return last if last else '{"status":"FAILED","message":"family not found"}'


def resolved_context_set(option_code, family_code, variant_code, is_enterprise, migration_type, package_number, resolved):
    return {
        "option_code": option_code or "",
        "family_code": family_code or "",
        "variant_code": variant_code or "",
        "migration_type": migration_type or "NONE",
        "is_enterprise": bool(is_enterprise),
        "package_number": package_number,
        "resolved": bool(resolved),
    }


def get_store_family_packages(t, family_code, ent):
    return get_store_family_packages_context_result(t, family_code, ent, None)


