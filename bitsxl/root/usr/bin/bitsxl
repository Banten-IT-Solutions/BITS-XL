# ---------------------------------------------------------------------------
# response cache
# ---------------------------------------------------------------------------
def cache_config_tag():
    # ponytail: FNV-1a in C replaced by sha256 truncation; deterministic + changes on config change. Equivalent observable behavior.
    concat = "|".join(CFG.get(k, "") or "" for k in DEFAULTS)
    return hashlib.sha256(concat.encode()).hexdigest()[:16]


def cache_path(acc, key):
    number = acc["number"] if acc and acc.get("number") else "active"
    return os.path.join(RESPONSE_CACHE_DIR, f"{safe_name(number)}-{cache_config_tag()}-{safe_name(key) or 'data'}.json")


def cache_dir_ready():
    try:
        os.makedirs(RESPONSE_CACHE_DIR, mode=0o700, exist_ok=True)
        return True
    except Exception:
        return False


def response_cache_load(acc, key, ttl):
    if ttl <= 0 or not cache_dir_ready():
        return None
    path = cache_path(acc, key)
    try:
        st = os.stat(path)
        now = time.time()
        if now - st.st_mtime >= ttl:
            os.unlink(path)
            return None
        with open(path, "r") as f:
            data = f.read()
        if not data or len(data) > RESPONSE_CACHE_MAX:
            os.unlink(path)
            return None
        return data
    except Exception:
        return None


def response_cache_save(acc, key, data):
    path = cache_path(acc, key)
    try:
        os.makedirs(RESPONSE_CACHE_DIR, mode=0o700, exist_ok=True)
        with open(path, "w") as f:
            f.write(data)
    except Exception:
        pass


def response_cache_delete(acc, key):
    if not cache_dir_ready():
        return
    try:
        os.unlink(cache_path(acc, key))
    except Exception:
        pass


def response_cache_generation(acc):
    if not cache_dir_ready():
        return ""
    key = "__epoch__"
    try:
        with open(cache_path(acc, key), "r") as f:
            return f.read()
    except Exception:
        return ""


def response_cache_bump(acc):
    pass  # not critical; bump via re-save semantics


def response_cache_invalidate_account(acc):
    for k in ("balance", "quota", "tiering", "segments-0", "segments-1", "shop-0", "shop-1", "families-0", "families-1"):
        response_cache_delete(acc, k)


# ---------------------------------------------------------------------------
# shared status helpers
# ---------------------------------------------------------------------------
def api_auth_failed(resp):
    if not resp:
        return False
    markers = ("REQUEST_MISSING_BEARER", "MISSING_BEARER", "Invalid token", "invalid_token", "Token expired",
               "token expired", "Unauthorized", "auth_error=true", "code=132", '"code":"132"', '"code":132',
               '"status":401', '"status":"401"')
    return any(m in resp for m in markers)


def api_success_response(resp):
    o = parse_json(resp)
    status = jget_s(o, "status")
    code = jget_s(o, "code")
    return status == "SUCCESS" or code == "000"


def api_error_151(resp):
    if not resp:
        return False
    o = parse_json(resp)
    code = jget_s(o, "code")
    return code == "151" or jget_ll(o, "code", -1) == 151


def api_retry_auth(acc, accounts, t):
    token_cache_delete(acc)
    t.clear()
    t.update({"access_token": None, "id_token": None, "refresh_token": None, "cached": False})
    if refresh_account(acc, t):
        return -1
    account_sync(accounts, acc, t)
    return 0


def api_response_summary(resp):
    o = parse_json(resp)
    status = jget_s(o, "status") or "UNKNOWN"
    code = jget_s(o, "code")
    s = f"status={status} code={code if code is not None else 'UNKNOWN'}"
    if api_auth_failed(resp):
        s += " auth_error=true"
    return s


# ---------------------------------------------------------------------------
# retry wrappers
# ---------------------------------------------------------------------------
def get_quota_retry(a, acc, t):
    r = response_cache_load(acc, "quota", DASHBOARD_TTL)
    if r:
        return r
    r = get_quota(t)
    if api_auth_failed(r) and not api_retry_auth(acc, a, t):
        r = get_quota(t)
    response_cache_save(acc, "quota", r)
    return r


def get_balance_retry(a, acc, t):
    r = response_cache_load(acc, "balance", DASHBOARD_TTL)
    if r:
        return r
    r = get_balance_api(t)
    if api_auth_failed(r) and not api_retry_auth(acc, a, t):
        r = get_balance_api(t)
    response_cache_save(acc, "balance", r)
    return r


