def cmd_json_payment_decoy_mode(mode, standard, n, codes, custom_amount):
    m = payment_config_missing()
    if m:
        out_json({"ok": False, "error": "missing env", "missing": m})
        return
    if require_json_payment_confirmed():
        return
    a, act, acc, t = json_payment_begin()
    if not acc:
        return
    total = [0]
    loaded = [0]
    q = []
    if load_payment_quotes_json(a, acc, t, n, codes, q, 3, total, loaded):
        return
    decoy = empty_quote()
    err = [None]
    refreshed = [0]
    if decoy_quote_resolve(a, acc, t, decoy, [None], err) != 0:
        out_json({"ok": False, "error": err[0] or "decoy resolve/validation failed before settlement"})
        return
    q.append(decoy)
    total[0] += decoy["price"]
    loaded[0] += 1
    amount = [payment_amount(total[0], custom_amount)]
    token_idx = 0 if standard else loaded[0] - 1
    payment_for_override = None if standard else DECOY_V2_PAYMENT_FOR
    resp = payment_pulsa_settle_retry(acc, t, q, loaded[0], amount, token_idx, payment_for_override)
    o = parse_json(resp)
    status = jget_s(o, "status")
    msg = jget_s(o, "message")
    ok = payment_ok_status(status)
    out = {"ok": ok, "payment": "balance", "mode": mode,
           "token_confirmation_idx": token_idx,
           "payment_for": q[0]["payment_for"] if standard else DECOY_V2_PAYMENT_FOR,
           "message": msg or status or "unknown",
           "quotes": print_quotes_json(q), "total_amount": amount[0], "response": jval(resp)}
    out_json(out)


def cmd_json_payment_qris_mode(mode, decoy_kind, n, codes, custom_amount):
    m = payment_config_missing()
    if m:
        out_json({"ok": False, "error": "missing env", "missing": m})
        return
    if require_json_payment_confirmed():
        return
    a, act, acc, t = json_payment_begin()
    if not acc:
        return
    total = [0]
    loaded = [0]
    q = []
    if load_payment_quotes_json(a, acc, t, n, codes, q, 3, total, loaded):
        return
    if decoy_kind:
        decoy = empty_quote()
        if decoy_quote_resolve(a, acc, t, decoy, [None], [None]) != 0:
            out_json({"ok": False, "error": "decoy resolve/validation failed before settlement"})
            return
        q.append(decoy)
        total[0] += decoy["price"]
        loaded[0] += 1
    amount = payment_amount(total[0], custom_amount)
    token_idx = loaded[0] - 1 if decoy_kind else 0
    payment_for = "SHARE_PACKAGE" if decoy_kind else None
    resp = payment_qris_settle_many_ex(acc, t, q, loaded[0], amount, token_idx, payment_for)
    o = parse_json(resp)
    status = jget_s(o, "status")
    message = jget_s(o, "message")
    transaction = jget_s(o, "transaction_code")
    ok = payment_ok_status(status)
    out = {"ok": ok, "payment": "qris", "mode": mode, "message": message or status or "unknown",
           "quotes": print_quotes_json(q), "total_amount": amount, "response": jval(resp)}
    if ok and transaction:
        pending = get_transaction_status_retry(a, acc, t, transaction, "")
        qr = jget_s(parse_json(pending), "qr_code")
        if transaction:
            out["transaction_code"] = transaction
        if pending:
            out["pending_detail"] = jval(pending)
        if qr:
            out["qris_code"] = qr
            out["qris_url"] = f"http://192.168.1.1/qrcode.php?data={b64_encode(qr.encode(), urlsafe=True)}"
    out_json(out)


def ewallet_method_arg(s):
    m = (s or "").upper()
    return m if m in ("DANA", "SHOPEEPAY", "GOPAY") else ""


def cmd_json_payment_ewallet_mode(method, n, codes, wallet_arg, custom_amount):
    m = payment_config_missing()
    if m:
        out_json({"ok": False, "error": "missing env", "missing": m})
        return
    if require_json_payment_confirmed():
        return
    wallet = wallet_api_number(wallet_arg)
    if method == "DANA" and (not wallet.startswith("08") or not (10 <= len(wallet) <= 13)):
        out_json({"ok": False, "error": "wallet number must start with 08 and contain 10-13 digits"})
        return
    a, act, acc, t = json_payment_begin()
    if not acc:
        return
    total = [0]
    loaded = [0]
    q = []
    if load_payment_quotes_json(a, acc, t, n, codes, q, 3, total, loaded):
        return
    amount = payment_amount(total[0], custom_amount)
    resp = payment_ewallet_settle_many(acc, t, q, loaded[0], amount, method, wallet)
    o = parse_json(resp)
    status = jget_s(o, "status")
    msg = jget_s(o, "message")
    deeplink = jget_s(o, "deeplink")
    ok = payment_ok_status(status)
    out = {"ok": ok, "payment": "ewallet", "method": method, "message": msg or status or "unknown",
           "quotes": print_quotes_json(q), "total_amount": amount, "response": jval(resp)}
    if deeplink:
        out["deeplink"] = deeplink
    out_json(out)


def cmd_json_payment_single_special(mode, n, codes, extra):
    m = payment_config_missing()
    if m:
        out_json({"ok": False, "error": "missing env", "missing": m})
        return
    if require_json_payment_confirmed():
        return
    if n != 1:
        out_json({"ok": False, "error": "payment mode supports one package only"})
        return
    dest = None
    if mode == "gift":
        dest = dest_msisdn(extra)
        if not msisdn_ok(dest):
            out_json({"ok": False, "error": "destination msisdn must start with 628"})
            return
    a, act, acc, t = json_payment_begin()
    if not acc:
        return
    q = empty_quote()
    if payment_quote_load(t, codes[0], q):
        out_json({"ok": False, "error": "quote failed"})
        return
    if (q.get("payment_for") or "") != "REDEEM_VOUCHER":
        out_json({"ok": False, "error": "payment mode requires REDEEM_VOUCHER", "payment": mode,
                  "payment_for": q["payment_for"], "quote": payment_quote_print_json(q)})
        return
    if mode == "point":
        resp = payment_point_settle(acc, t, q)
    elif mode == "voucher":
        resp = payment_voucher_settle(acc, t, q)
    else:
        resp = payment_gift_settle(acc, t, q, dest)
    o = parse_json(resp)
    status = jget_s(o, "status")
    msg = jget_s(o, "message")
    ok = payment_ok_status(status)
    out_json({"ok": ok, "payment": mode, "message": msg or status or "unknown",
              "quote": payment_quote_print_json(q), "response": jval(resp)})


# ---------------------------------------------------------------------------
# human commands
# ---------------------------------------------------------------------------
def delete_account_number(number):
    a = accounts_load()
    token_cache_delete({"number": number})
    response_cache_invalidate_account({"number": number})
    a = [it for it in a if it["number"] != number]
    for it in a:
        it["dirty"] = True
    accounts_save(a)
    act = active_get()
    if act == number:
        active_set("")


def cmd_login(inp):
    number = login_msisdn(inp)
    if not number:
        die("number must use 08 or 628 format and contain 8-14 normalized digits")
    resp = request_otp(number)
    if "subscriber_id" in resp:
        print(f"OTP requested for {number}. Next: bitsxl otp {number} <code>")
    else:
        print(f"OTP response: {resp}")


def cmd_otp(inp, code):
    number = login_msisdn(inp)
    if not number:
        die("number must use 08 or 628 format and contain 8-14 normalized digits")
    if not otp_ok(code):
        die("otp must be 6 digits")
    resp = submit_otp("SMS", number, code)
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if parse_tokens(resp, t):
        die(f"login failed: {resp}")
    profile = get_profile(t)
    po = parse_json(profile)
    sub = jget_s(po, "subscriber_id") or ""
    typ = jget_s(po, "subscription_type") or ""
    a = accounts_load()
    accounts_put(a, number, sub, typ, t["refresh_token"])
    saved = accounts_find(a, number)
    if saved:
        token_cache_save(saved, t)
    accounts_save(a)
    active_set(number)
    print(f"saved {number} [{typ or 'unknown'}]")


def cmd_accounts():
    a = accounts_load()
    act = active_get()
    if not a:
        print("no accounts")
    for it in a:
        star = "*" if act == it["number"] else " "
        print(f"{star} {it['number']} [{it['subscription_type']}]")


def cmd_use(number):
    a = accounts_load()
    if not accounts_find(a, number):
        die(f"account not found: {number}")
    active_set(number)
    print(f"active: {number}")


def cmd_del(number):
    delete_account_number(number)
    print(f"deleted: {number}")


def cmd_logout():
    act = active_get()
    a = accounts_load()
    acc = accounts_find(a, act) if act else None
    if acc:
        token_cache_delete(acc)
        response_cache_invalidate_account(acc)
    active_set("")
    print(f"session reset{':' if act else ''}{act}")


def cmd_env():
    print(f"home: {CFG['home']}")
    print(f"env: {CFG['env_path'] or '(none)'}")
    for k in CONFIG_REQUIRED:
        state = "ok" if CFG[k] else "missing"
        print(f"{k}: {state}")
    for k in ("DECOY_PREPAID_FAMILY_CODE", "DECOY_PREPAID_PACKAGE_NUMBER", "DECOY_PRIORITAS_FAMILY_CODE",
              "DECOY_PRIORITAS_PACKAGE_NUMBER", "DECOY_PRIOHYBRID_FAMILY_CODE", "DECOY_PRIOHYBRID_PACKAGE_NUMBER"):
        if k.endswith("FAMILY_CODE"):
            state = "set" if CFG[k] else ("fallback PRIORITAS" if k.startswith("DECOY_PRIOHYBRID") else "default")
        else:
            v = decoy_package_number_parse(CFG[k])
            state = "set" if v is not None else ("invalid" if CFG[k] else ("fallback PRIORITAS" if k.startswith("DECOY_PRIOHYBRID") else "default"))
        print(f"{k}: {state}")
    print("libmbedcrypto: linked")


def show_quota_pretty(j, number, subtype):
    o = parse_json(j)
    quotas = (o.get("quotas") if isinstance(o, dict) else None) or []
    print("=" * 55)
    print(f"             MyXL Quota - {number}")
    print(f"                    {subtype or ''}")
    print("=" * 55)
    for idx, obj in enumerate(quotas, 1):
        name = obj.get("name") if isinstance(obj, dict) else None
        code = obj.get("quota_code")
        domain = obj.get("product_domain")
        pst = obj.get("product_subscription_type")
        print(f"\n[{idx}] {name or '(no name)'}  (code: {code}) (domain: {domain}) (type: {pst})")
    print("=" * 55)
    return quotas


def cmd_quota(number_arg):
    a = accounts_load()
    number = number_arg
    if not number:
        number = active_get()
    if not number:
        die("no active account. run: bitsxl use <number>")
    acc = accounts_find(a, number)
    if not acc:
        die(f"account not found: {number}")
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if refresh_account(acc, t):
        sys.exit(1)
    account_sync(a, acc, t)
    q = get_quota(t)
    show_quota_pretty(q, acc["number"], acc["subscription_type"])


def cli_begin():
    a = accounts_load()
    act = active_get()
    acc = accounts_find(a, act) if act else None
    if not acc:
        sys.stderr.write("no active account. run: bitsxl use <number>\n")
        return None, None, None, None
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if refresh_account(acc, t):
        sys.stderr.write(f"refresh failed: {acc['number']}\n")
        return None, None, None, None
    account_sync(a, acc, t)
    return a, act, acc, t


def cmd_shop(enterprise_arg):
    a, act, acc, t = cli_begin()
    if not acc:
        sys.exit(1)
    shop = get_store_packages_retry(a, acc, t, is_true(enterprise_arg))
    print(shop)


def cmd_segments(enterprise_arg):
    a, act, acc, t = cli_begin()
    if not acc:
        sys.exit(1)
    segments = get_store_segments_retry(a, acc, t, is_true(enterprise_arg))
    print(segments)


def cmd_pay_quote(option_code):
    a, act, acc, t = cli_begin()
    if not acc:
        sys.exit(1)
    q = empty_quote()
    if payment_quote_load(t, option_code, q) != 0:
        return
    # pretty-print quote
    print(f"Paket: {q['item_name']}")
    print(f"Family: {q['family']}")
    print(f"Harga: Rp {money_id(q['price'])}")


def cmd_pay_pulsa(option_code, confirm, custom_amount):
    m = payment_config_missing()
    if m:
        die(f"missing env {m}")
    a, act, acc, t = cli_begin()
    if not acc:
        sys.exit(1)
    q = empty_quote()
    if payment_quote_load(t, option_code, q):
        return
    amount = payment_amount(q["price"], custom_amount)
    expect = f"BAYAR-{amount}"
    if not confirm or confirm != expect:
        die(f"confirm required: bitsxl pay-pulsa {option_code} {expect}")
    resp = payment_pulsa_settle_many(acc, t, [q], 1, amount)
    print(resp)


def cmd_pay_human(mode, n, codes):
    m = payment_config_missing()
    if m:
        die(f"missing env {m}")
    if n < 1:
        die("missing package code")
    a, act, acc, t = cli_begin()
    if not acc:
        sys.exit(1)
    q = []
    total = 0
    for code in codes:
        qq = empty_quote()
        if payment_quote_load(t, code, qq):
            sys.stderr.write(f"quote failed {code}\n")
            sys.exit(1)
        total += qq["price"]
        q.append(qq)
    amount = payment_amount(total, -1)
    if mode == "balance":
        resp = payment_pulsa_settle_many(acc, t, q, len(q), amount)
    elif mode == "decoy-standard":
        decoy = empty_quote()
        if decoy_quote_resolve(a, acc, t, decoy, [None], [None]) != 0:
            die("decoy resolve failed")
        q.append(decoy)
        amount += decoy["price"]
        resp = payment_pulsa_settle_many_raw(acc, t, q, len(q), amount, 0, None)
    elif mode == "decoy-v2":
        decoy = empty_quote()
        if decoy_quote_resolve(a, acc, t, decoy, [None], [None]) != 0:
            die("decoy resolve failed")
        q.append(decoy)
        amount += decoy["price"]
        resp = payment_pulsa_settle_many_raw(acc, t, q, len(q), amount, len(q) - 1, DECOY_V2_PAYMENT_FOR)
    elif mode == "qris":
        resp = payment_qris_settle_many_ex(acc, t, q, len(q), amount, 0, None)
    else:
        die("mode not supported human")
    o = parse_json(resp)
    status = jget_s(o, "status")
    msg = jget_s(o, "message")
    print(f"Result: {status or 'UNKNOWN'}{' - ' if msg else ''}{msg or ''}")


def cmd_transaction_history_human():
    a, act, acc, t = cli_begin()
    if not acc:
        sys.exit(1)
    print(get_transaction_history_retry(a, acc, t))


def cmd_pending_transactions_human():
    a, act, acc, t = cli_begin()
    if not acc:
        sys.exit(1)
    print(get_pending_transactions_retry(a, acc, t))


def cmd_transaction_status_human(tx, status_arg):
    if not tx:
        die("missing transaction id")
    a, act, acc, t = cli_begin()
    if not acc:
        sys.exit(1)
    print(get_transaction_status_retry(a, acc, t, tx, status_arg or ""))


# ---------------------------------------------------------------------------
# interactive menu (simplified but functional)
# ---------------------------------------------------------------------------
def prompt_line(label):
    try:
        return input(label).strip()
    except EOFError:
        return ""


def pause_enter():
    try:
        input("Tekan Enter untuk lanjut...")
    except EOFError:
        pass


def interactive_main_menu():
    while True:
        a = accounts_load()
        act = active_get()
        acc = accounts_find(a, act) if act else None
        print("\033[H\033[J", end="")
        print("=" * 55)
        if acc:
            print(f"Nomor: {acc['number']} | Type: {acc['subscription_type']}")
        else:
            print("Belum ada akun aktif")
        print("=" * 55)
        print("Menu:\n1. Login/Ganti akun\n2. Lihat Paket Saya\n3. Store Segments\n4. Store Packages\n5. Beli Paket Berdasarkan Family Code\n6. Point / Redeemables\n7. Beli Semua Paket dalam Family Code\n0. Kuota\n99. Tutup aplikasi")
        choice = prompt_line("Pilih menu: ")
        if choice == "99":
            return
        if choice == "1":
            interactive_account_menu()
        elif choice == "2" or choice == "0":
            if not acc:
                print("No active user. Pilih/login akun dulu.")
                pause_enter()
            else:
                interactive_quota(acc["number"])
        elif choice == "3":
            cmd_segments("")
        elif choice == "4":
            cmd_shop("")
        elif choice == "6":
            interactive_redeemables("")
        else:
            print("Pilihan tidak valid.")
            pause_enter()


def interactive_login_prompt():
    print("-" * 55)
    print("Login ke MyXL")
    inp = prompt_line("Nomor XL (08xxxx / 628xxxx): ")
    number = login_msisdn(inp)
    if not number:
        print("Nomor tidak valid.")
        pause_enter()
        return
    otp_res = request_otp(number)
    if "subscriber_id" not in otp_res:
        print(f"Gagal request OTP:\n{otp_res}")
        pause_enter()
        return
    print("OTP berhasil dikirim.")
    for tries in (3, 2, 1):
        otp = prompt_line("Masukkan OTP: ")
        if not otp_ok(otp):
            print("OTP tidak valid. Harus 6 digit angka.")
            continue
        resp = submit_otp("SMS", number, otp)
        t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
        if parse_tokens(resp, t):
            print(f"OTP salah/gagal:\n{resp}")
            continue
        profile = get_profile(t)
        po = parse_json(profile)
        sub = jget_s(po, "subscriber_id") or ""
        typ = jget_s(po, "subscription_type") or ""
        a = accounts_load()
        accounts_put(a, number, sub, typ, t["refresh_token"])
        saved = accounts_find(a, number)
        if saved:
            token_cache_save(saved, t)
        accounts_save(a)
        active_set(number)
        print(f"Berhasil login: {number} [{typ or 'unknown'}]")
        pause_enter()
        return
    print("Gagal login setelah beberapa percobaan.")
    pause_enter()


def interactive_account_menu():
    while True:
        a = accounts_load()
        act = active_get()
        print("\033[H\033[J", end="")
        print("-" * 55)
        print("Akun Tersimpan:")
        if not a:
            print("Tidak ada akun tersimpan.")
        for i, it in enumerate(a, 1):
            marker = "(Aktif)" if act == it["number"] else ""
            print(f"{i}. {it['number']} [{it['subscription_type']}] {marker}")
        print("-" * 55)
        choice = prompt_line("Pilihan: ")
        if choice == "00":
            return
        if choice == "0":
            interactive_login_prompt()
            continue
        if choice.startswith("del "):
            try:
                idx = int(choice[4:])
            except ValueError:
                print("Nomor urut tidak valid.")
                pause_enter()
                continue
            if idx < 1 or idx > len(a):
                print("Nomor urut tidak valid.")
            elif act == a[idx - 1]["number"]:
                print("Tidak dapat menghapus akun aktif.")
            else:
                delete_account_number(a[idx - 1]["number"])
                print("Akun berhasil dihapus.")
            pause_enter()
            continue
        if choice.isdigit():
            idx = int(choice)
            if 1 <= idx <= len(a):
                active_set(a[idx - 1]["number"])
                print(f"Akun aktif: {a[idx - 1]['number']}")
                pause_enter()
                return
        print("Input tidak valid.")
        pause_enter()


def interactive_quota(number):
    while True:
        acc = accounts_find(accounts_load(), number)
        if not acc:
            print(f"Akun tidak ditemukan: {number}")
            pause_enter()
            return
        t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
        if refresh_account(acc, t):
            print("Gagal refresh token.")
            pause_enter()
            return
        q = get_quota(t)
        show_quota_pretty(q, acc["number"], acc["subscription_type"])
        choice = prompt_line("Pilihan (00/Enter kembali): ")
        if choice in ("", "00"):
            return


def interactive_redeemables(enterprise_arg):
    a, act, acc = cli_begin()
    if not acc:
        pause_enter()
        return
    res = get_redeemables_retry(a, acc, {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}, is_true(enterprise_arg))
    print(res)
    pause_enter()


def usage():
    print("bitsxl                 # menu interaktif")
    print("bitsxl json dashboard|status|accounts|quota|segments|tiering|history|pending|notifications|point|redeemables|shop|family-list|env|settings|login|otp|use|del|logout|reset-session|unsub|payment ...")
    print("bitsxl login <08...|628...>")
    print("bitsxl otp <08...|628...> <code>")
    print("bitsxl accounts")
    print("bitsxl use <628...>")
    print("bitsxl del <628...>")
    print("bitsxl logout")
    print("bitsxl quota [628...]")
    print("bitsxl env")
    print("bitsxl pay-quote <package_code>")
    print("bitsxl pay-pulsa <package_code> [--amount rupiah] BAYAR-<harga>")


# ---------------------------------------------------------------------------
# json dispatch
# ---------------------------------------------------------------------------
def cmd_json(argv):
    if not argv:
        out_json({"ok": False, "error": "missing json command"})
        return 0
    c0 = argv[0]
    if c0 in ("dashboard", "status"):
        if json_require_config():
            return 1
        cmd_json_dashboard()
    elif c0 == "accounts":
        cmd_json_accounts()
    elif c0 in ("env", "settings"):
        cmd_json_env()
    elif c0 == "quota":
        if json_require_config():
            return 1
        cmd_json_quota(argv[1] if len(argv) >= 2 else None, len(argv) >= 3 and argv[2] == "fresh")
    elif c0 == "tiering":
        if json_require_config():
            return 1
        cmd_json_tiering()
    elif c0 in ("transaction-history", "history"):
        if json_require_config():
            return 1
        cmd_json_transaction_history()
    elif c0 in ("pending", "pending-transactions"):
        if json_require_config():
            return 1
        cmd_json_pending_transactions()
    elif c0 in ("transaction-status", "status-transaction", "payment-status"):
        if json_require_config():
            return 1
        cmd_json_transaction_status(argv[1] if len(argv) >= 2 else None, argv[2] if len(argv) >= 3 else "")
    elif c0 in ("notifications", "notification"):
        if json_require_config():
            return 1
        cmd_json_notifications()
    elif c0 in ("notification-detail", "notification-read", "notification-read-all"):
        if json_require_config():
            return 1
        cmd_json_notification_read(argv[1:])
    elif c0 in ("point", "redeemables"):
        if json_require_config():
            return 1
        cmd_json_redeemables(argv[1] if len(argv) >= 2 else "")
    elif c0 in ("segments", "store-segments"):
        if json_require_config():
            return 1
        cmd_json_store_segments(argv[1] if len(argv) >= 2 else "")
    elif c0 in ("shop", "store-packages"):
        if json_require_config():
            return 1
        if len(argv) >= 3 and argv[1] == "family":
            cmd_json_shop_family(argv[2], argv[3] if len(argv) >= 4 else "")
        elif len(argv) >= 2 and argv[1] == "family-list":
            cmd_json_shop_family_list(argv[2] if len(argv) >= 3 else "")
        else:
            cmd_json_shop(argv[1] if len(argv) >= 2 else "")
    elif c0 == "family-list":
        if json_require_config():
            return 1
        cmd_json_shop_family_list(argv[1] if len(argv) >= 2 else "")
    elif c0 == "family":
        if json_require_config():
            return 1
        cmd_json_shop_family(argv[1] if len(argv) >= 2 else None, argv[2] if len(argv) >= 3 else "")
    elif c0 in ("package", "detail") and len(argv) >= 2:
        if json_require_config():
            return 1
        if c0 == "package" and argv[1] == "detail":
            cmd_json_package_detail(argv[2] if len(argv) >= 3 else None, argv[3] if len(argv) >= 4 else "",
                                     argv[4] if len(argv) >= 5 else "", argv[5] if len(argv) >= 6 else "")
        else:
            cmd_json_package_detail(argv[1], argv[2] if len(argv) >= 3 else "", argv[3] if len(argv) >= 4 else "", argv[4] if len(argv) >= 5 else "")
    elif c0 == "payment" and len(argv) >= 2:
        if json_require_config():
            return 1
        pay_argv = argv[2:]
        pay_argv, confirmed = strip_json_confirm_args(pay_argv)
        if pay_argv is None:
            out_json({"ok": False, "error": "invalid confirm"})
            return 1
        global json_payment_confirmed
        json_payment_confirmed = confirmed
        pay_argv, custom = strip_custom_amount_args(pay_argv)
        if pay_argv is None:
            out_json({"ok": False, "error": "invalid custom amount"})
            return 1
        custom = -1 if custom is None else custom
        p1 = argv[1]
        if p1 == "quote":
            if not pay_argv:
                out_json({"ok": False, "error": "missing package code"})
            else:
                cmd_json_payment_quote(pay_argv[0])
        elif p1 == "probe":
            if not pay_argv:
                out_json({"ok": False, "error": "missing package code"})
            else:
                cmd_json_payment_probe(pay_argv[0])
        elif p1 == "pulsa":
            if not pay_argv:
                out_json({"ok": False, "error": "missing package code"})
            else:
                cmd_json_payment_pulsa(pay_argv[0], pay_argv[1] if len(pay_argv) >= 2 else None, custom)
        elif p1 == "cart":
            cmd_json_payment_pulsa_cart(len(pay_argv), pay_argv, custom)
        elif p1 in ("auto", "balance"):
            cmd_json_payment_balance_mode(p1, len(pay_argv), pay_argv, custom)
        elif p1 in ("balance-decoy-standard", "decoy-standard"):
            cmd_json_payment_decoy_mode("balance-decoy-standard", True, len(pay_argv), pay_argv, custom)
        elif p1 in ("balance-decoy-v2", "decoy-v2", "balance-decoy", "decoy", "prio"):
            cmd_json_payment_decoy_mode("balance-decoy-v2", False, len(pay_argv), pay_argv, custom)
        elif p1 == "qris":
            cmd_json_payment_qris_mode("qris", None, len(pay_argv), pay_argv, custom)
        elif p1 == "dana":
            if len(pay_argv) < 2:
                out_json({"ok": False, "error": "missing wallet/package"})
            else:
                cmd_json_payment_ewallet_mode("DANA", len(pay_argv) - 1, pay_argv, pay_argv[-1], custom)
        elif p1 == "shopeepay":
            cmd_json_payment_ewallet_mode("SHOPEEPAY", len(pay_argv), pay_argv, "", custom)
        elif p1 == "gopay":
            cmd_json_payment_ewallet_mode("GOPAY", len(pay_argv), pay_argv, "", custom)
        elif p1 == "ewallet":
            m = ewallet_method_arg(pay_argv[0]) if pay_argv else ""
            if len(pay_argv) < 3:
                out_json({"ok": False, "error": "usage: payment ewallet METHOD wallet_or_dash code..."})
            elif not m:
                out_json({"ok": False, "error": "unsupported ewallet"})
            else:
                wallet = "" if pay_argv[1] == "-" else pay_argv[1]
                cmd_json_payment_ewallet_mode(m, len(pay_argv) - 2, pay_argv[2:], wallet, custom)
        elif p1 == "point":
            if custom >= 0:
                out_json({"ok": False, "error": "custom amount not supported for point"})
            else:
                cmd_json_payment_single_special("point", len(pay_argv), pay_argv, None)
        elif p1 == "voucher":
            if custom >= 0:
                out_json({"ok": False, "error": "custom amount not supported for voucher"})
            else:
                cmd_json_payment_single_special("voucher", len(pay_argv), pay_argv, None)
        elif p1 == "gift":
            if custom >= 0:
                out_json({"ok": False, "error": "custom amount not supported for gift"})
            elif len(pay_argv) < 2:
                out_json({"ok": False, "error": "missing destination/package"})
            else:
                cmd_json_payment_single_special("gift", len(pay_argv) - 1, pay_argv, pay_argv[-1])
        elif p1 in ("status", "pending-detail"):
            cmd_json_transaction_status(pay_argv[0] if pay_argv else None, pay_argv[1] if len(pay_argv) >= 2 else "")
        elif p1 in ("history", "transaction-history"):
            cmd_json_transaction_history()
        else:
            out_json({"ok": False, "error": "unknown payment command"})
    elif c0 == "pay-quote" and len(argv) >= 2:
        if json_require_config():
            return 1
        cmd_json_payment_quote(argv[1])
    elif c0 == "pay-pulsa" and len(argv) >= 2:
        if json_require_config():
            return 1
        pay_argv = argv[1:]
        pay_argv, custom = strip_custom_amount_args(pay_argv)
        if pay_argv is None:
            out_json({"ok": False, "error": "invalid custom amount"})
            return 1
        if not pay_argv:
            out_json({"ok": False, "error": "missing package code"})
        else:
            cmd_json_payment_pulsa(pay_argv[0], pay_argv[1] if len(pay_argv) >= 2 else None, -1 if custom is None else custom)
    elif c0 == "use" and len(argv) >= 2:
        cmd_json_use(argv[1])
    elif c0 == "del" and len(argv) >= 2:
        cmd_json_del(argv[1])
    elif c0 in ("logout", "reset-session"):
        cmd_json_logout()
    elif c0 in ("unsub", "unsubscribe") and len(argv) >= 2:
        if json_require_config():
            return 1
        cmd_json_unsub(argv[1], argv[2] if len(argv) >= 3 else "", argv[3] if len(argv) >= 4 else "")
    elif c0 == "login" and len(argv) >= 2:
        if json_require_config():
            return 1
        cmd_json_login(argv[1])
    elif c0 == "otp" and len(argv) >= 3:
        if json_require_config():
            return 1
        cmd_json_otp(argv[1], argv[2])
    else:
        out_json({"ok": False, "error": "unknown json command"})
    return 0


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
def main(argv):
    load_config()
    if len(argv) < 2:
        require_config()
        interactive_main_menu()
        return 0
    c1 = argv[1]
    if c1 in ("--version", "-V", "version"):
        print(VERSION)
        return 0
    if c1 in ("--help", "-h", "help"):
        usage()
        return 0
    if c1 == "login" and len(argv) == 3:
        require_config()
        cmd_login(argv[2])
    elif c1 == "otp" and len(argv) == 4:
        require_config()
        cmd_otp(argv[2], argv[3])
    elif c1 == "accounts":
        cmd_accounts()
    elif c1 == "accounts-json":
        cmd_json_accounts()
    elif c1 == "use" and len(argv) == 3:
        cmd_use(argv[2])
    elif c1 == "del" and len(argv) == 3:
        cmd_del(argv[2])
    elif c1 in ("logout", "reset-session"):
        cmd_logout()
    elif c1 == "quota":
        require_config()
        cmd_quota(argv[2] if len(argv) >= 3 else None)
    elif c1 == "quota-json":
        if json_require_config():
            return 1
        cmd_json_quota(argv[2] if len(argv) >= 3 else None, len(argv) >= 4 and argv[3] == "fresh")
    elif c1 in ("segments", "store-segments"):
        require_config()
        cmd_segments(argv[2] if len(argv) >= 3 else "")
    elif c1 in ("point", "redeemables"):
        require_config()
        interactive_redeemables(argv[2] if len(argv) >= 3 else "")
    elif c1 in ("shop", "store-packages"):
        require_config()
        cmd_shop(argv[2] if len(argv) >= 3 else "")
    elif c1 in ("history", "transaction-history"):
        require_config()
        cmd_transaction_history_human()
    elif c1 in ("pending", "pending-transactions"):
        require_config()
        cmd_pending_transactions_human()
    elif c1 in ("transaction-status", "status-transaction", "payment-status"):
        require_config()
        cmd_transaction_status_human(argv[2] if len(argv) >= 3 else None, argv[3] if len(argv) >= 4 else "")
    elif c1 == "pay-quote" and len(argv) >= 3:
        require_config()
        cmd_pay_quote(argv[2])
    elif c1 == "pay-pulsa" and len(argv) >= 3:
        require_config()
        a = argv[2:]
        a, custom = strip_custom_amount_args(a)
        if a is None:
            die("invalid custom amount")
        if not a:
            die("missing package code")
        cmd_pay_pulsa(a[0], a[1] if len(a) >= 2 else None, -1 if custom is None else custom)
    elif c1 in ("pay-balance", "pay-auto"):
        require_config()
        a = argv[2:]
        a, _ = strip_custom_amount_args(a)
        cmd_pay_human("balance", len(a), a)
    elif c1 in ("pay-balance-decoy-standard", "pay-decoy-standard"):
        require_config()
        a = argv[2:]
        a, _ = strip_custom_amount_args(a)
        cmd_pay_human("decoy-standard", len(a), a)
    elif c1 in ("pay-balance-decoy-v2", "pay-decoy-v2", "pay-decoy", "pay-balance-decoy"):
        require_config()
        a = argv[2:]
        a, _ = strip_custom_amount_args(a)
        cmd_pay_human("decoy-v2", len(a), a)
    elif c1 == "pay-qris":
        require_config()
        a = argv[2:]
        a, _ = strip_custom_amount_args(a)
        cmd_pay_human("qris", len(a), a)
    elif c1 == "pay-ewallet":
        require_config()
        a = argv[2:]
        print("ewallet human not implemented; use json payment ewallet")
    elif c1 in ("pay-point", "pay-voucher", "pay-gift"):
        require_config()
        print("special payment human not implemented; use json payment")
    elif c1 == "status-json" or c1 == "dashboard-json":
        if json_require_config():
            return 1
        cmd_json_dashboard()
    elif c1 == "env":
        cmd_env()
    elif c1 in ("env-json", "settings-json"):
        cmd_json_env()
    elif c1 == "json":
        return cmd_json(argv[2:])
    else:
        usage()
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))