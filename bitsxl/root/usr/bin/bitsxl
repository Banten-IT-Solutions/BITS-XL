def payment_point_settle(acc, t, q):
    if q["timestamp"] < 0:
        return '{"status":"FAILED","message":"missing package timestamp"}'
    path = "gamification/api/v8/loyalties/tiering/exchange"
    payload = json.dumps({
        "item_code": q["item_code"], "amount": 0, "partner": "", "is_enterprise": False,
        "item_name": "", "lang": "en", "points": q["price"], "timestamp": q["timestamp"],
        "token_confirmation": q["token_confirmation"],
    })
    sig = make_x_signature_loyalty(q["timestamp"], q["item_code"], q["token_confirmation"], path)
    response_cache_invalidate_account(acc)
    resp = api_request_custom_sig(path, payload, t, sig)
    response_cache_invalidate_account(acc)
    return resp


def payment_gift_settle(acc, t, q, dest):
    if q["timestamp"] < 0:
        return '{"status":"FAILED","message":"missing package timestamp"}'
    path = "gamification/api/v8/loyalties/tiering/bounties-allotment"
    now = int(time.time())
    payload = json.dumps({
        "destination_msisdn": dest, "item_code": q["item_code"], "is_enterprise": False,
        "item_name": q["item_name"], "lang": "en", "timestamp": now, "token_confirmation": q["token_confirmation"],
    })
    sig = make_x_signature_bounty_allotment(q["timestamp"], q["item_code"], q["token_confirmation"], path, dest)
    response_cache_invalidate_account(acc)
    resp = api_request_custom_sig(path, payload, t, sig)
    response_cache_invalidate_account(acc)
    return resp


# ---------------------------------------------------------------------------
# decoy resolution
# ---------------------------------------------------------------------------
PREPAID_BUILTIN = ("b0a20d74-0c54-4e3b-8f3f-01e7482e50bf", "719d093f-6f8d-46a4-8390-6a0003a172ea", 1, "true", "NONE")
PRIO_BUILTIN = ("2512b72a-a3cd-4c70-a736-132cf2c1f0c0", "cff298bd-8ec8-4696-b689-12407d36be15", 1, "", "")


def subscription_upper(acc):
    return (acc.get("subscription_type") or "").upper()


def subscription_priohybrid(acc):
    return subscription_upper(acc) == "PRIOHYBRID"


def subscription_prio(acc):
    return subscription_upper(acc) in ("PRIORITAS", "PRIOHYBRID", "GO")


def decoy_family_code_valid(s):
    return bool(s) and 1 <= len(s) <= 128 and not any(ch.isspace() or ord(ch) < 32 for ch in s)


def decoy_package_number_parse(s):
    if not s:
        return None
    try:
        v = int(s)
    except ValueError:
        return None
    return v if 1 <= v <= 2147483647 else None


def decoy_config_choice(acc):
    # returns (configured, category, family_code, package_number, prioritas_fallback)
    if subscription_priohybrid(acc):
        if CFG["DECOY_PRIOHYBRID_FAMILY_CODE"] or CFG["DECOY_PRIOHYBRID_PACKAGE_NUMBER"]:
            return ("PRIOHYBRID", CFG["DECOY_PRIOHYBRID_FAMILY_CODE"], CFG["DECOY_PRIOHYBRID_PACKAGE_NUMBER"], False)
        return ("PRIORITAS", CFG["DECOY_PRIORITAS_FAMILY_CODE"], CFG["DECOY_PRIORITAS_PACKAGE_NUMBER"], True)
    if subscription_prio(acc):
        return ("PRIORITAS", CFG["DECOY_PRIORITAS_FAMILY_CODE"], CFG["DECOY_PRIORITAS_PACKAGE_NUMBER"], False)
    return ("PREPAID", CFG["DECOY_PREPAID_FAMILY_CODE"], CFG["DECOY_PREPAID_PACKAGE_NUMBER"], False)


def family_variant_order_context(t, family_code, variant_code, order, enterprise_arg, migration_arg, context, err_out=None):
    result = [-1]
    shop = get_store_family_packages_context_result(t, family_code, enterprise_arg, migration_arg, context, result)
    context["variant_code"] = variant_code
    if result[0] != 0:
        return result[0]
    o = parse_json(shop)
    data = jdup(o, "data") if isinstance(o, dict) else shop
    variants = (data.get("package_variants") if isinstance(data, dict) else None) or []
    flattened = 0
    found = None
    for variant in variants:
        vc = variant.get("package_variant_code") if isinstance(variant, dict) else None
        for option in (variant.get("package_options") or []) if isinstance(variant, dict) else []:
            flat_order = option.get("order", -1) if isinstance(option, dict) else -1
            flattened += 1
            if vc == variant_code and flat_order == order:
                found = option.get("package_option_code")
                break
        if found:
            break
    if found:
        context.update(resolved_context_set(found, context.get("family_code", ""), variant_code,
                                            context.get("is_enterprise", False),
                                            context.get("migration_type", "NONE"),
                                            flattened, 1))
        return 0
    return -1


def decoy_package_context_once(t, acc, context, err_out=None):
    choice = decoy_config_choice(acc)
    category, fam, num, fallback = choice
    has_family = bool(fam)
    has_number = bool(num)
    if has_family != has_number:
        return -1
    if has_family:
        if not decoy_family_code_valid(fam):
            return -1
        pn = decoy_package_number_parse(num)
        if pn is None:
            return -1
        result = [-1]
        shop = get_store_family_packages_context_result(t, fam, None, None, context, result)
        context["package_number"] = pn
        if result[0] == 0:
            # flatten to option code at package_number
            o = parse_json(shop)
            data = (jdup(o, "data") if isinstance(o, dict) else None) or {}
            variants = data.get("package_variants") or []
            idx = 0
            found = None
            found_variant = None
            for variant in variants:
                vc = variant.get("package_variant_code")
                for option in (variant.get("package_options") or []):
                    idx += 1
                    if idx == pn:
                        found = option.get("package_option_code")
                        found_variant = vc
                        break
                if found:
                    break
            if found and found_variant:
                context.update(resolved_context_set(found, fam, found_variant,
                                                    context.get("is_enterprise", False),
                                                    context.get("migration_type", "NONE"),
                                                    pn, 1))
                return 0
        return -1
    if subscription_prio(acc):
        return family_variant_order_context(t, *PRIO_BUILTIN, context, err_out)
    return family_variant_order_context(t, *PREPAID_BUILTIN, context, err_out)


def decoy_quote_resolve(accounts, acc, t, quote, option_code_out, err_out):
    context = {}
    result = decoy_package_context_once(t, acc, context, err_out)
    if result:
        return -1
    result = payment_quote_load_context(t, context, quote)
    if result == 0 and option_code_out is not None:
        option_code_out[0] = quote["item_code"]
    return result if result != 0 else 0


# ---------------------------------------------------------------------------
# msisdn helpers
# ---------------------------------------------------------------------------
def normalize_msisdn(inp):
    digits = "".join(ch for ch in (inp or "") if ch.isdigit())
    if digits.startswith("08"):
        return "62" + digits[1:]
    if digits.startswith("8"):
        return "62" + digits
    return digits


def msisdn_ok(s):
    if not s.startswith("628"):
        return False
    if len(s) < 8 or len(s) > 14:
        return False
    return s.isdigit()


def login_msisdn(inp):
    number = normalize_msisdn(inp)
    if msisdn_ok(number):
        return number
    return None


def otp_ok(s):
    return bool(s) and len(s) == 6 and s.isdigit()


def wallet_api_number(inp):
    digits = "".join(ch for ch in (inp or "") if ch.isdigit())
    if digits.startswith("628"):
        return "0" + digits[2:]
    if digits.startswith("8"):
        return "0" + digits
    return digits


def dest_msisdn(inp):
    digits = "".join(ch for ch in (inp or "") if ch.isdigit())
    if digits.startswith("08"):
        return "62" + digits[1:]
    if digits.startswith("8"):
        return "62" + digits
    return digits


def family_code_ok(s):
    return bool(s) and 1 <= len(s) <= 128 and not any(ord(ch) < 32 or ch.isspace() for ch in s)


def purchase_code_ok(s):
    return bool(s) and 1 <= len(s) <= 255 and not any(ord(ch) < 32 or ch.isspace() for ch in s)


def notification_id_ok(s):
    return bool(s) and 1 <= len(s) <= 256 and not any(ord(ch) < 32 or ch.isspace() for ch in s)


# ---------------------------------------------------------------------------
# json output helpers
# ---------------------------------------------------------------------------
def out_json(obj):
    print(json.dumps(obj, ensure_ascii=False))


def json_require_config():
    m = config_missing()
    if not m:
        return False
    out_json({"ok": False, "error": "missing env", "missing": m})
    return True


def json_auth_error(resp):
    out_json({"ok": False, "error": "auth failed", "response": jval(resp)})


def json_accounts_fields(a, act):
    return {
        "active": act or "",
        "accounts": [
            {"number": it["number"], "subscription_type": it["subscription_type"], "active": it["number"] == act}
            for it in a
        ],
    }


def load_active_account(err_label="no active account"):
    """Returns (accounts, act, acc) or (None,None,None) with an error printed."""
    a = accounts_load()
    act = active_get()
    acc = accounts_find(a, act) if act else None
    if not acc:
        out_json({"ok": False, "error": err_label, "active": act or ""})
        return None, None, None
    return a, act, acc


def json_payment_begin():
    a, act, acc = load_active_account()
    if not acc:
        return None, None, None, None
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if refresh_account(acc, t):
        out_json({"ok": False, "error": "refresh failed", "number": acc["number"]})
        return None, None, None, None
    account_sync(a, acc, t)
    return a, act, acc, t


def load_payment_quotes_json(a, acc, t, n, codes, q, max_n, total, loaded):
    if n < 1:
        out_json({"ok": False, "error": "missing package code"})
        return -1
    if n > max_n:
        out_json({"ok": False, "error": f"cart max {max_n} packages"})
        return -1
    total[0] = 0
    loaded[0] = 0
    for i in range(n):
        qq = empty_quote()
        if payment_quote_load(t, codes[i], qq):
            out_json({"ok": False, "error": "quote failed", "index": i, "code": codes[i]})
            return -1
        total[0] += qq["price"]
        q.append(qq)
        loaded[0] += 1
    return 0


def empty_quote():
    return {"item_code": "", "item_name": "", "family": "", "validity": "", "payment_for": "",
            "token_confirmation": "", "price": 0, "balance": -1, "timestamp": -1,
            "context": resolved_context_set("", "", "", False, "NONE", 0, 0)}


def print_quotes_json(quotes):
    return [payment_quote_print_json(q) for q in quotes]


def print_amount_json(total, amount):
    if amount != total:
        return {"total_amount": amount, "custom_price": amount}
    return {"total_amount": amount}


def strip_custom_amount_args(argv):
    custom = -1
    out = []
    i = 0
    while i < len(argv):
        a = argv[i]
        handled = False
        for flag in ("--amount", "--price", "--custom-price"):
            if a == flag:
                if i + 1 >= len(argv):
                    return None, None
                custom = int(argv[i + 1]) if argv[i + 1].isdigit() else -1
                i += 2
                handled = True
                break
        if not handled:
            out.append(a)
            i += 1
    return out, custom


def confirm_arg_ok(s):
    return s in ("1", "true", "yes", "CONFIRM", "confirm")


def strip_json_confirm_args(argv):
    confirmed = False
    out = []
    for a in argv:
        if a in ("--confirm", "confirm"):
            confirmed = True
            continue
        if a.startswith("confirm="):
            v = a[8:]
            if confirm_arg_ok(v):
                confirmed = True
            else:
                return None, None
            continue
        if a.startswith("confirmed="):
            v = a[10:]
            if confirm_arg_ok(v):
                confirmed = True
            else:
                return None, None
            continue
        out.append(a)
    return out, confirmed


def require_json_payment_confirmed():
    global json_payment_confirmed
    if json_payment_confirmed:
        return False
    out_json({"ok": False, "error": "confirm required", "confirm": "confirm=1"})
    return True


