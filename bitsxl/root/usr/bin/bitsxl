def accounts_path():
    return os.path.join(CFG["home"], "accounts.tsv")


def active_path():
    return os.path.join(CFG["home"], "active")


def accounts_load():
    a = []
    try:
        with open(accounts_path(), "r") as f:
            for line in f.read().splitlines():
                line = line.strip()
                if not line:
                    continue
                parts = line.split("\t")
                if len(parts) < 4:
                    continue
                a.append({"number": parts[0], "subscriber_id": parts[1], "subscription_type": parts[2], "refresh_token": parts[3], "dirty": False, "is_new": False})
    except Exception:
        pass
    return a


def accounts_save(a):
    # ponytail: best-effort write, no flock (single-process invocation model). Add fcntl.flock if concurrent use shows races.
    try:
        os.makedirs(CFG["home"], mode=0o700, exist_ok=True)
        tmp = accounts_path() + f".{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            for it in a:
                f.write(f"{it['number']}\t{it['subscriber_id']}\t{it['subscription_type']}\t{it['refresh_token']}\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, accounts_path())
    except Exception:
        pass


def accounts_find(a, number):
    for it in a:
        if it["number"] == number:
            return it
    return None


def accounts_put(a, number, sub, typ, rt):
    e = accounts_find(a, number)
    if not e:
        e = {"number": number, "subscriber_id": "", "subscription_type": "", "refresh_token": "", "dirty": True, "is_new": True}
        a.append(e)
    changed = False
    if sub and e["subscriber_id"] != sub:
        e["subscriber_id"] = sub
        changed = True
    if typ and e["subscription_type"] != typ:
        e["subscription_type"] = typ
        changed = True
    if rt and e["refresh_token"] != rt:
        e["refresh_token"] = rt
        changed = True
    if changed:
        e["dirty"] = True


def active_get():
    try:
        with open(active_path(), "r") as f:
            return f.read().strip()
    except Exception:
        return ""


def active_set(number):
    try:
        os.makedirs(CFG["home"], mode=0o700, exist_ok=True)
        with open(active_path(), "w") as f:
            f.write(number)
    except Exception:
        pass


def safe_name(number):
    return "".join(c if c.isalnum() or c in "_-" else "_" for c in (number or "active")) or "active"


def token_cache_path(a):
    n = a["number"] if a and a.get("number") else "active"
    return os.path.join(CFG["home"], f"token-{safe_name(n)}.json")


def token_cache_load(a, t):
    try:
        with open(token_cache_path(a), "r") as f:
            o = json.load(f)
    except Exception:
        return -1
    if not isinstance(o, dict):
        return -1
    exp = o.get("expires_at", 0)
    if not isinstance(exp, int) or exp <= int(time.time()):
        return -1
    at = o.get("access_token")
    it = o.get("id_token")
    rt = o.get("refresh_token")
    if not rt and a and a.get("refresh_token"):
        rt = a["refresh_token"]
    if not at or not it or not rt:
        return -1
    t["access_token"] = at
    t["id_token"] = it
    t["refresh_token"] = rt
    t["cached"] = True
    return 0


def token_cache_save(a, t):
    if not a or not t.get("access_token") or not t.get("id_token") or not t.get("refresh_token"):
        return
    data = json.dumps({
        "expires_at": int(time.time()) + TOKEN_CACHE_TTL,
        "access_token": t["access_token"],
        "id_token": t["id_token"],
        "refresh_token": t["refresh_token"],
    })
    try:
        os.makedirs(CFG["home"], mode=0o700, exist_ok=True)
        with open(token_cache_path(a), "w") as f:
            f.write(data)
    except Exception:
        pass


def token_cache_delete(a):
    try:
        os.unlink(token_cache_path(a))
    except Exception:
        pass


def parse_tokens(j, t):
    o = parse_json(j)
    if not isinstance(o, dict):
        return -1
    at = o.get("access_token")
    it = o.get("id_token")
    rt = o.get("refresh_token")
    if not at or not it or not rt:
        return -1
    t["access_token"] = at
    t["id_token"] = it
    t["refresh_token"] = rt
    return 0


def refresh_account(a, t):
    if not a.get("refresh_token"):
        sys.stderr.write("refresh token missing\n")
        return -1
    if token_cache_load(a, t) == 0:
        return 0
    resp = refresh_token_http(a["refresh_token"])
    if "Session not active" in resp:
        if not a.get("subscriber_id"):
            sys.stderr.write("session inactive and subscriber_id missing\n")
            token_cache_delete(a)
            return -1
        ex = extend_session(a["subscriber_id"])
        code = jget_s(parse_json(ex), "exchange_code")
        if not code:
            sys.stderr.write(f"extend-session failed: {ex}\n")
            token_cache_delete(a)
            return -1
        resp = submit_otp("DEVICEID", a["subscriber_id"], code)
    if parse_tokens(resp, t):
        sys.stderr.write(f"refresh failed: {resp}\n")
        token_cache_delete(a)
        return -1
    token_cache_save(a, t)
    return 0


def get_profile(t):
    payload = json.dumps({"access_token": t["access_token"], "app_version": "8.9.0", "is_enterprise": False, "lang": "en"})
    return api_request("api/v8/profile", payload, t["id_token"])


def account_update_profile(a, t):
    changed = False
    if t.get("refresh_token") and a["refresh_token"] != t["refresh_token"]:
        a["refresh_token"] = t["refresh_token"]
        changed = True
    if not (t.get("cached") and a.get("subscriber_id") and a.get("subscription_type")):
        profile = get_profile(t)
        po = parse_json(profile)
        sub = jget_s(po, "subscriber_id")
        typ = jget_s(po, "subscription_type")
        if typ and a["subscription_type"] != typ:
            a["subscription_type"] = typ
            changed = True
        if sub and a["subscriber_id"] != sub:
            a["subscriber_id"] = sub
            changed = True
    if changed:
        a["dirty"] = True
    return changed


def account_sync(accounts, account, t):
    if account_update_profile(account, t):
        accounts_save(accounts)


