# ---------------------------------------------------------------------------
# payment quote helpers
# ---------------------------------------------------------------------------
def payment_quote_load(t, option_code, q):
    detail = get_package_detail_api(t, option_code)
    o = parse_json(detail)
    if not isinstance(o, dict) or "data" not in detail:
        return -1
    data = jdup(o, "data") or {}
    option = jdup(data, "package_option") or {}
    family = jdup(data, "package_family") or {}
    variant = jdup(data, "package_detail_variant") or {}
    option_name = jget_s(option, "name")
    variant_name = jget_s(variant, "name")
    family_name = jget_s(family, "name")
    validity = jget_s(option, "validity")
    payment_for = jget_s(family, "payment_for")
    token = jget_s(data, "token_confirmation")
    price = jget_llany(option, "price", -1)
    timestamp = jget_llany(data, "timestamp", -1)
    if not token or price < 0:
        return -1
    item_name = f"{variant_name} {option_name}" if (variant_name and option_name) else (option_name or variant_name or option_code)
    if not payment_for:
        payment_for = "BUY_PACKAGE"
    q.update({
        "item_code": option_code, "item_name": item_name, "family": family_name or "",
        "validity": validity or "", "payment_for": payment_for, "token_confirmation": token,
        "price": price, "balance": -1, "timestamp": timestamp,
        "context": resolved_context_set(option_code, "", "", False, "NONE", 0, 0),
    })
    return 0


def payment_quote_load_context(t, context, q):
    # used for decoy: context is fully resolved; load detail and fill quote fields
    if not (context.get("resolved") and context.get("option_code") and context.get("family_code")
            and context.get("variant_code") and context.get("migration_type")):
        return -1
    detail = get_package_detail_api_ex(t, context["option_code"], context["family_code"],
                                       context["variant_code"], context["is_enterprise"],
                                       context["migration_type"])
    o = parse_json(detail)
    status = jget_s(o, "status")
    data = jdup(o, "data")
    option = jdup(data, "package_option")
    if status != "SUCCESS" or not data or not option:
        return -2 if api_error_151(detail) else (-3 if api_auth_failed(detail) else -1)
    family = jdup(data, "package_family") or {}
    variant = jdup(data, "package_detail_variant") or {}
    option_name = jget_s(option, "name")
    variant_name = jget_s(variant, "name")
    family_name = jget_s(family, "name")
    validity = jget_s(option, "validity")
    payment_for = jget_s(family, "payment_for")
    token = jget_s(data, "token_confirmation")
    returned_option = jget_s(option, "package_option_code")
    returned_family = jget_s(family, "package_family_code")
    returned_variant = jget_s(variant, "package_variant_code")
    price = jget_llany(option, "price", -1)
    timestamp = jget_llany(data, "timestamp", -1)
    if (returned_family and returned_family != context["family_code"]) or \
       (returned_variant and returned_variant != context["variant_code"]):
        return -1
    if not returned_option or not token or price < 0:
        return -1
    item_name = f"{variant_name} {option_name}" if (variant_name and option_name) else (option_name or variant_name or returned_option)
    if not payment_for:
        payment_for = "BUY_PACKAGE"
    q.update({
        "item_code": returned_option, "item_name": item_name, "family": family_name or "",
        "validity": validity or "", "payment_for": payment_for, "token_confirmation": token,
        "price": price, "balance": -1, "timestamp": timestamp,
    })
    q["context"] = dict(context)
    return 0


def payment_quote_load_retry(a, acc, t, code, q, err_out):
    if payment_quote_load(t, code, q) == 0:
        return 0
    # on auth failure error_path, retry once
    if api_auth_failed(q.get("_last_err", "")):
        if not api_retry_auth(acc, a, t):
            return payment_quote_load(t, code, q)
    return -1


def payment_cart_context(quotes, n):
    for q in quotes[:n]:
        if q.get("context", {}).get("resolved"):
            return q["context"]
    return None


def payment_quote_print_json(q):
    prod = {
        "code": q["item_code"], "name": q["item_name"], "family": q["family"],
        "validity": q["validity"], "payment_for": q["payment_for"],
        "price": q["price"], "timestamp": q["timestamp"],
    }
    out = {"product": prod, "pulsa": {"balance": q["balance"]}}
    c = q.get("context", {})
    if c.get("resolved"):
        out["package_context"] = {
            "option_code": c["option_code"], "family_code": c["family_code"], "variant_code": c["variant_code"],
            "is_enterprise": c["is_enterprise"], "migration_type": c["migration_type"],
            "package_number": c["package_number"],
        }
    return out


def send_balance_settlement(path, payload, t, targets, token_payment, payment_for, payment_ts):
    return api_request_payment(path, payload, t, targets, token_payment, payment_for, payment_ts)


def payment_items_json(q, n):
    targets = ""
    items = []
    for i in range(n):
        if i:
            targets += ";"
        targets += q[i]["item_code"]
        items.append({
            "item_code": q[i]["item_code"], "product_type": "", "item_price": q[i]["price"],
            "item_name": q[i]["item_name"], "tax": 0, "token_confirmation": q[i]["token_confirmation"],
        })
    return targets, items


def payment_pulsa_settle_many_raw(acc, t, q, n, total, token_idx, payment_for_override):
    if n < 1:
        return '{"status":"FAILED","message":"empty cart"}'
    ti = (token_idx + n) % n if token_idx < 0 else (token_idx if 0 <= token_idx < n else 0)
    payment_for = payment_for_override if payment_for_override else q[0]["payment_for"]
    ctx = payment_cart_context(q, n)
    settlement_migration = ctx["migration_type"] if ctx else ""
    intercept_page_api(t, q[0]["item_code"])
    methods = payment_methods_api(t, q[ti])
    if api_auth_failed(methods):
        response_cache_invalidate_account(acc)
        token_cache_delete(acc)
    mo = parse_json(methods)
    status = jget_s(mo, "status")
    token_payment = jget_s(mo, "token_payment")
    payment_ts = jget_llany(mo, "timestamp", -1)
    if status != "SUCCESS" or not token_payment or payment_ts < 0:
        summary = api_response_summary(methods)
        return json.dumps({"status": "FAILED", "message": f"payment methods failed: {summary}"})
    targets, items = payment_items_json(q, n)
    ept = encrypted_empty_field()
    eauth = encrypted_empty_field()
    now = int(time.time())
    original = q[n - 1]["price"]
    payload = json.dumps({
        "total_discount": 0, "is_enterprise": bool(ctx and ctx["is_enterprise"]),
        "payment_token": "", "token_payment": token_payment, "activated_autobuy_code": "",
        "cc_payment_type": "", "is_myxl_wallet": False, "pin": "", "ewallet_promo_id": "", "members": [],
        "total_fee": 0, "fingerprint": "", "autobuy_threshold_setting": {"label": "", "type": "", "value": 0},
        "is_use_point": False, "lang": "en", "payment_method": "BALANCE", "timestamp": now,
        "points_gained": 0, "can_trigger_rating": False, "akrab_members": [], "akrab_parent_alias": "",
        "referral_unique_code": "", "coupon": "", "payment_for": payment_for, "with_upsell": False,
        "topup_number": "", "stage_token": "", "authentication_id": "", "encrypted_payment_token": ept,
        "token": "", "token_confirmation": "", "access_token": t["access_token"], "wallet_number": "",
        "encrypted_authentication_id": eauth,
        "additional_data": {
            "original_price": original, "is_spend_limit_temporary": False, "migration_type": settlement_migration,
            "akrab_m2m_group_id": "false", "spend_limit_amount": 0, "is_spend_limit": False, "mission_id": "",
            "tax": 0, "quota_bonus": 0, "cashtag": "", "is_family_plan": False, "combo_details": [],
            "is_switch_plan": False, "discount_recurring": 0, "is_akrab_m2m": False, "balance_type": "PREPAID_BALANCE",
            "has_bonus": False, "discount_promo": 0,
        },
        "total_amount": total, "is_using_autobuy": False, "items": items,
    })
    response_cache_invalidate_account(acc)
    resp = send_balance_settlement("payments/api/v8/settlement-multipayment", payload, t, targets, token_payment, payment_for, payment_ts)
    response_cache_invalidate_account(acc)
    if api_auth_failed(resp):
        token_cache_delete(acc)
        t.clear()
    return resp


def payment_response_add_context(response, context):
    if not response or not context or not context.get("resolved"):
        return response
    o = parse_json(response)
    if isinstance(o, dict) and o.get("status") == "SUCCESS":
        return response
    if isinstance(o, dict):
        o["package_context"] = {
            "option_code": context["option_code"], "family_code": context["family_code"],
            "package_number": context["package_number"], "variant_code": context["variant_code"],
            "is_enterprise": context["is_enterprise"], "migration_type": context["migration_type"],
        }
        return json.dumps(o)
    return json.dumps({"status": "FAILED", "message": "settlement gagal", "package_context": {
        "option_code": context["option_code"], "family_code": context["family_code"],
        "package_number": context["package_number"], "variant_code": context["variant_code"],
        "is_enterprise": context["is_enterprise"], "migration_type": context["migration_type"],
    }})


def payment_pulsa_settle_many(acc, t, q, n, total):
    return payment_pulsa_settle_many_raw(acc, t, q, n, total, 0, None)


def payment_ok_status(status):
    return status == "SUCCESS"


def payment_amount(total, custom_amount):
    return custom_amount if custom_amount >= 0 else total


def payment_bizz_amount(resp):
    o = parse_json(resp)
    if not isinstance(o, dict):
        return -1
    status = jget_s(o, "status")
    message = jget_s(o, "message")
    if status == "SUCCESS" or not message:
        return -1
    p = message.find("Bizz-err.Amount.Total")
    if p < 0:
        return -1
    p = message.find("=", p)
    if p < 0:
        return -1
    try:
        v = int(message[p + 1:].lstrip().split()[0].split(",")[0] if message[p + 1:].lstrip() else "")
        return v if v >= 0 else -1
    except Exception:
        return -1


def payment_pulsa_settle_retry(acc, t, q, n, amount_v, token_idx, payment_for_override):
    amount = amount_v[0]
    context = payment_cart_context(q, n)
    resp = payment_pulsa_settle_many_raw(acc, t, q, n, amount, token_idx, payment_for_override)
    o = parse_json(resp)
    status = jget_s(o, "status")
    valid = -1 if payment_ok_status(status) else payment_bizz_amount(resp)
    if valid < 0:
        return payment_response_add_context(resp, context)
    amount_v[0] = valid
    resp = payment_pulsa_settle_many_raw(acc, t, q, n, valid, token_idx, payment_for_override)
    return payment_response_add_context(resp, context)


