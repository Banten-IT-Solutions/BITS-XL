def cmd_json_notification_read(ids):
    if len(ids) < 1:
        out_json({"ok": False, "error": "missing notification id"})
        return
    if len(ids) > 64:
        out_json({"ok": False, "error": "too many notification ids", "limit": 64})
        return
    for i, nid in enumerate(ids):
        if not notification_id_ok(nid):
            out_json({"ok": False, "error": "invalid notification id", "index": i})
            return
    a, act, acc = load_active_account()
    if not acc:
        return
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if refresh_account(acc, t):
        out_json({"ok": False, "error": "refresh failed", "number": acc["number"]})
        return
    account_sync(a, acc, t)
    results = []
    marked = 0
    attempted = 0
    auth_failed = False
    for nid in ids:
        detail = get_notification_detail_once(acc, t, nid)
        auth = api_auth_failed(detail)
        ok = (not auth) and api_success_response(detail)
        results.append({"notification_id": nid, "ok": ok, "response": jval(detail)})
        attempted += 1
        if ok:
            marked += 1
        if auth:
            auth_failed = True
            break
    out = {"results": results, "ok": marked == len(ids), "requested": len(ids), "attempted": attempted, "marked": marked}
    if auth_failed:
        out["error"] = "auth failed; retry action manually"
    elif marked != len(ids):
        out["error"] = "one or more notifications failed"
    out_json(out)


def cmd_json_use(number):
    a = accounts_load()
    acc = accounts_find(a, number)
    if not acc:
        out_json({"ok": False, "error": "account not found"})
        return
    active_set(number)
    out_json({"ok": True, "active": number})


def cmd_json_del(number):
    a = accounts_load()
    if not accounts_find(a, number):
        out_json({"ok": False, "error": "account not found"})
        return
    delete_account_number(number)
    out_json({"ok": True})


def cmd_json_logout():
    act = active_get()
    a = accounts_load()
    acc = accounts_find(a, act) if act else None
    if acc:
        token_cache_delete(acc)
        response_cache_invalidate_account(acc)
    active_set("")
    out_json({"ok": True, "previous_active": act or ""})


def cmd_json_login(inp):
    number = login_msisdn(inp)
    if not number:
        out_json({"ok": False, "error": "number must use 08 or 628 format"})
        return
    resp = request_otp(number)
    ok = "subscriber_id" in resp
    out_json({"ok": ok, "response": jval(resp)})


def cmd_json_otp(inp, code):
    number = login_msisdn(inp)
    if not number:
        out_json({"ok": False, "error": "number must use 08 or 628 format"})
        return
    if not otp_ok(code):
        out_json({"ok": False, "error": "otp must be 6 digits"})
        return
    resp = submit_otp("SMS", number, code)
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if parse_tokens(resp, t):
        out_json({"ok": False, "response": jval(resp)})
        return
    profile = get_profile(t)
    po = parse_json(profile)
    sub = jget_s(po, "subscriber_id") or ""
    typ = jget_s(po, "subscription_type") or ""
    a = accounts_load()
    accounts_put(a, number, sub, typ, t["refresh_token"])
    saved = accounts_find(a, number)
    if saved:
        token_cache_save(saved, t)
    accounts_save(a)
    active_set(number)
    out_json({"ok": True, "number": number, "subscription_type": typ or "unknown"})


def cmd_json_unsub(code, subtype, domain):
    a, act, acc = load_active_account()
    if not acc:
        return
    if not code:
        out_json({"ok": False, "error": "missing quota code"})
        return
    t = {"access_token": None, "id_token": None, "refresh_token": None, "cached": False}
    if refresh_account(acc, t):
        out_json({"ok": False, "error": "refresh failed", "number": acc["number"]})
        return
    account_sync(a, acc, t)
    res = unsubscribe_quota_once(a, acc, t, code, subtype or "", domain or "")
    ok = (not api_auth_failed(res)) and api_success_response(res)
    out_json({"ok": ok, "response": jval(res)})


